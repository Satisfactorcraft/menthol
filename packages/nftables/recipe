# UNVERIFIED: version and URL were not checked against upstream, and the checksum is not pinned.
name=nftables
version=1.1.3
desc="Packet filtering (nft), used by the hardening stage"
depends="libmnl libnftnl"
source=(https://www.netfilter.org/projects/nftables/files/nftables-$version.tar.xz)
sha256=(SKIP)
build() {
  cd nftables-$version
  ./configure --prefix=/usr --sbindir=/usr/sbin --sysconfdir=/etc --with-cli=readline --without-json --disable-man-doc
  make
  make DESTDIR="$PKG" install
}
